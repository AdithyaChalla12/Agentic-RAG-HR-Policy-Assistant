# ---------- LLM (router, graders, rewriter, generators) ----------
# groq (fast + free tier) or openai
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_API_KEY=

# ---------- Embeddings ----------
# huggingface = local all-MiniLM-L6-v2 (384-dim, free). openai = text-embedding-3-small (1536-dim)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Vector DB ----------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-rag-copilot
PINECONE_NAMESPACE=company-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------- Web search ----------
TAVILY_API_KEY=

# ---------- Agent behavior ----------
ASSISTANT_NAME=People Ops Copilot
DOMAIN_DESCRIPTION=HR policies, benefits, leave, payroll, onboarding, expenses, travel, and workplace conduct at Lumen Labs
TOP_K=4
# Skip the LLM grader when the best vector score is below this (0 disables the shortcut)
MIN_RELEVANCE_SCORE=0.0
MAX_RETRIES=1

# ---------- Security ----------
ADMIN_API_KEY=change-me
